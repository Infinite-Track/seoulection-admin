# docker-compose-prod.yml 이 읽는 환경변수 견본.
# 어드민 인스턴스에서 `cp .env.example .env` 후 값을 채운다. .env 는 gitignore 대상이다.
#
# compose 는 서비스를 고르기 전에 파일 전체를 보간한다 → :? 로 표시된 값이 하나라도 비면
# 거기서 바로 멈춘다.

# ── 필수 ────────────────────────────────────────────────

# 배포할 이미지 태그. CI 가 sha-<커밋7자리> 와 latest 를 함께 올린다.
# 🔴 latest 를 쓰지 말 것. 배포하는 순간의 내용은 SHA 태그와 같지만 그 이름의 뜻이 계속 바뀐다:
#    롤백 대상을 부를 이름이 없어지고, "지금 뜬 게 어느 커밋인가" 에도 답할 수 없다.
#    이 한 줄을 바꾸는 것이 곧 배포 버튼이자 배포 기록이다.
ADMIN_IMAGE_TAG=sha-899dc78

# DB 인스턴스(api-server 가 사는 곳)의 사설 IP. 퍼블릭 IP 가 아니다.
# ⚠️ 인스턴스를 교체하면 바뀐다. 그쪽 .env 의 DB_BIND_IP 와 같은 값이어야 한다.
# 확인: 그 인스턴스에서  hostname -I | awk '{print $1}'
DB_HOST=192.168.3.38

# api-server 인스턴스의 .env 에 있는 POSTGRES_PASSWORD 와 동일한 값.
# ⚠️ 다르면 기동은 되고 쿼리에서 인증 실패한다.
POSTGRES_PASSWORD=

# ── 선택 (기본값 있음) ──────────────────────────────────

# 기능성 자동 판정. 한글 제품명으로 의약품안전나라를 조회해 기능성 등록 여부를 판정한다.
# 설계는 docs/functional-screening.md 참조.
#
# 🔴 앱 기본값은 켜짐(true)이지만 compose 는 꺼짐으로 넘긴다. 키가 없는 채로 켜져 있으면
#    조회가 전부 FAILED 로 쌓이기 때문이다. 아래 키를 채우는 시점에 함께 true 로 올릴 것.
#FUNCTIONAL_SCREENING_ENABLED=false

# data.go.kr 발급 키. ⚠️ URL 인코딩된 형태 그대로 넣는다(디코딩하지 말 것).
#MFDS_SERVICE_KEY=

# 이름 해석(브랜드 한글 표기·등록명 후보·동일 제품 판정)을 Gemini 에 맡길지.
# 꺼져 있으면 규칙 기반 대체 구현이 돌고, 애매한 건 전부 사람 큐로 간다.
# ⚠️ 켜도 api-key 가 비면 호출을 건너뛰고 규칙만으로 판정한다(조용히 죽지는 않는다).
#FUNCTIONAL_SCREENING_LLM=false
#GEMINI_API_KEY=
